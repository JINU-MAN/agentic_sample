# Google Gemini API key
GOOGLE_API_KEY=

# OpenAI API key
OPENAI_API_KEY=

# Tavily API key (used by mcp_local/web_search_server.py)
TAVILY_API_KEY=

# Default model for all agents (overridable per-agent via /setting)
AGENTIC_DEFAULT_MODEL=gemini-2.5-flash-lite

# Slack MCP server script path
SLACK_MCP_SERVER_PATH=./mcp_local/slack_server.py

# Slack Web API token (used by mcp/slack_server.py)
SLACK_BOT_TOKEN=
